doctype html
html(lang="en")
  head
    meta(charset='UTF-8')
    meta(http-equiv='X-UA-Compatible' content='IE=edge')
    meta(name='viewport' content='width=device-width, initial-scale=1.0')
    title Pratistha Financial Services - Apply for Loan
    
    link(rel='stylesheet' href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css')
    link(rel='stylesheet' href='https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css')
    link(rel='preconnect' href='https://fonts.googleapis.com')
    link(rel='preconnect' href='https://fonts.gstatic.com' crossorigin)
    link(href='https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=Outfit:wght@300;400;600&display=swap' rel='stylesheet')
    
    style.
      :root {
        --primary-emerald: #059669;
        --primary-dark: #047857;
        --accent-gold: #f59e0b;
        --text-primary: #1f2937;
        --text-secondary: #6b7280;
        --bg-light: #f9fafb;
        --gradient-start: #10b981;
        --gradient-end: #059669;
      }

      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family: 'Outfit', sans-serif;
        color: var(--text-primary);
        overflow-x: hidden;
        background: linear-gradient(180deg, #ffffff 0%, var(--bg-light) 100%);
      }

      h1, h2, h3, h4, h5 {
        font-family: 'Playfair Display', serif;
      }

      /* Navbar Styles */
      .navbar {
        background: linear-gradient(135deg, #1f2937 0%, #111827 100%) !important;
        backdrop-filter: blur(10px);
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
        transition: all 0.3s ease;
      }

      .navbar-brand {
        font-weight: 700;
        font-size: 1.4rem;
        letter-spacing: -0.5px;
      }

      .navbar-brand img {
        border: 2px solid var(--accent-gold);
        transition: transform 0.3s ease;
      }

      .navbar-brand:hover img {
        transform: rotate(360deg) scale(1.1);
      }

      .nav-link {
        position: relative;
        font-weight: 500;
        transition: all 0.3s ease;
      }

      .nav-link::after {
        content: '';
        position: absolute;
        bottom: -5px;
        left: 50%;
        width: 0;
        height: 2px;
        background: var(--accent-gold);
        transition: all 0.3s ease;
        transform: translateX(-50%);
      }

      .nav-link:hover::after {
        width: 80%;
      }

      /* Hero Section */
      .hero-section {
        background: linear-gradient(135deg, rgba(5, 150, 105, 0.95) 0%, rgba(4, 120, 87, 0.9) 100%);
        padding: 160px 20px 100px;
        text-align: center;
        color: white;
        position: relative;
        overflow: hidden;
      }

      .hero-section::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: radial-gradient(circle at 30% 50%, rgba(245, 158, 11, 0.15) 0%, transparent 50%);
        animation: pulse 8s ease-in-out infinite;
      }

      @keyframes pulse {
        0%, 100% { opacity: 0.5; }
        50% { opacity: 1; }
      }

      .hero-section h1 {
        font-size: clamp(2.5rem, 5vw, 4rem);
        margin-bottom: 1rem;
        text-shadow: 2px 2px 4px rgba(0,0,0,0.2);
        position: relative;
        z-index: 1;
      }

      .hero-section p {
        font-size: clamp(1rem, 2vw, 1.3rem);
        max-width: 700px;
        margin: 0 auto;
        opacity: 0.95;
        position: relative;
        z-index: 1;
      }

      /* Application Section */
      .application-section {
        padding: 80px 0;
      }

      .application-container {
        max-width: 900px;
        margin: 0 auto;
        background: white;
        border-radius: 25px;
        box-shadow: 0 15px 50px rgba(0, 0, 0, 0.1);
        overflow: hidden;
      }

      /* Progress Bar */
      .progress-container {
        background: linear-gradient(135deg, var(--gradient-start), var(--gradient-end));
        padding: 30px 40px;
        color: white;
      }

      .progress-steps {
        display: flex;
        justify-content: space-between;
        align-items: center;
        position: relative;
        margin-bottom: 15px;
      }

      .progress-line {
        position: absolute;
        top: 20px;
        left: 0;
        right: 0;
        height: 3px;
        background: rgba(255, 255, 255, 0.3);
        z-index: 0;
      }

      .progress-line-fill {
        height: 100%;
        background: white;
        transition: width 0.3s ease;
      }

      .step {
        position: relative;
        z-index: 1;
        text-align: center;
        flex: 1;
      }

      .step-circle {
        width: 40px;
        height: 40px;
        background: rgba(255, 255, 255, 0.3);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 8px;
        font-weight: 600;
        transition: all 0.3s ease;
      }

      .step.active .step-circle {
        background: white;
        color: var(--primary-emerald);
        box-shadow: 0 5px 15px rgba(255, 255, 255, 0.4);
      }

      .step.completed .step-circle {
        background: white;
        color: var(--primary-emerald);
      }

      .step.completed .step-circle::before {
        content: '✓';
      }

      .step-label {
        font-size: 0.85rem;
        opacity: 0.8;
      }

      .step.active .step-label {
        opacity: 1;
        font-weight: 600;
      }

      /* Form Container */
      .form-container {
        padding: 50px 40px;
      }

      .logo-header {
        text-align: center;
        margin-bottom: 40px;
      }

      .logo-header img {
        width: 120px;
        height: 120px;
        object-fit: contain;
        border-radius: 50%;
        border: 3px solid var(--primary-emerald);
        padding: 10px;
        background: white;
        box-shadow: 0 5px 20px rgba(0, 0, 0, 0.1);
      }

      .logo-header h2 {
        margin-top: 20px;
        color: var(--text-primary);
        font-size: 2rem;
      }

      .logo-header p {
        color: var(--text-secondary);
        margin-top: 10px;
      }

      /* Form Steps */
      .form-step {
        display: none;
      }

      .form-step.active {
        display: block;
        animation: fadeIn 0.4s ease-in;
      }

      @keyframes fadeIn {
        from {
          opacity: 0;
          transform: translateY(20px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      .step-title {
        font-size: 1.8rem;
        color: var(--text-primary);
        margin-bottom: 30px;
        padding-bottom: 15px;
        border-bottom: 3px solid var(--primary-emerald);
      }

      .form-label {
        font-weight: 600;
        color: var(--text-primary);
        margin-bottom: 0.5rem;
        font-size: 1rem;
        display: flex;
        align-items: center;
      }

      .form-label i {
        margin-right: 8px;
        color: var(--primary-emerald);
      }

      .form-control,
      .form-select {
        padding: 15px 20px;
        border-radius: 12px;
        border: 2px solid #e5e7eb;
        font-size: 1rem;
        transition: all 0.3s ease;
      }

      .form-control:focus,
      .form-select:focus {
        border-color: var(--primary-emerald);
        box-shadow: 0 0 0 0.2rem rgba(5, 150, 105, 0.15);
        outline: none;
      }

      .form-control.is-valid,
      .form-select.is-valid {
        border-color: var(--primary-emerald);
      }

      .form-control.is-invalid,
      .form-select.is-invalid {
        border-color: #ef4444;
      }

      .invalid-feedback,
      .valid-feedback {
        font-size: 0.875rem;
        margin-top: 0.5rem;
      }

      /* Buttons */
      .form-navigation {
        display: flex;
        justify-content: space-between;
        gap: 20px;
        margin-top: 40px;
      }

      .btn-prev,
      .btn-next,
      .btn-submit {
        padding: 14px 40px;
        border-radius: 50px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 1px;
        transition: all 0.3s ease;
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
        border: none;
        cursor: pointer;
        font-size: 0.95rem;
      }

      .btn-prev {
        background: #6b7280;
        color: white;
      }

      .btn-prev:hover {
        background: #4b5563;
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15);
      }

      .btn-next,
      .btn-submit {
        background: linear-gradient(135deg, var(--gradient-start), var(--gradient-end));
        color: white;
        flex: 1;
      }

      .btn-next:hover,
      .btn-submit:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(5, 150, 105, 0.3);
      }

      .btn-submit:disabled {
        opacity: 0.6;
        cursor: not-allowed;
        transform: none;
      }

      .spinner-border-sm {
        width: 1rem;
        height: 1rem;
        border-width: 0.15em;
      }

      /* Info Cards */
      .info-card {
        background: linear-gradient(135deg, #ecfdf5, #d1fae5);
        padding: 20px 25px;
        border-radius: 15px;
        margin-bottom: 30px;
        border-left: 5px solid var(--primary-emerald);
      }

      .info-card i {
        color: var(--primary-emerald);
        font-size: 1.5rem;
        margin-right: 15px;
      }

      .info-card p {
        margin: 0;
        color: var(--text-secondary);
        line-height: 1.7;
      }

      /* Success Modal */
      .success-modal {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0, 0, 0, 0.5);
        z-index: 9999;
        align-items: center;
        justify-content: center;
      }

      .success-modal.show {
        display: flex;
      }

      .modal-content-custom {
        background: white;
        padding: 50px;
        border-radius: 25px;
        text-align: center;
        max-width: 500px;
        margin: 20px;
        animation: modalSlideIn 0.4s ease-out;
      }

      @keyframes modalSlideIn {
        from {
          opacity: 0;
          transform: translateY(-50px) scale(0.9);
        }
        to {
          opacity: 1;
          transform: translateY(0) scale(1);
        }
      }

      .modal-icon {
        width: 80px;
        height: 80px;
        background: linear-gradient(135deg, var(--gradient-start), var(--gradient-end));
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 25px;
        font-size: 2.5rem;
        color: white;
        box-shadow: 0 10px 30px rgba(5, 150, 105, 0.3);
      }

      .modal-content-custom h3 {
        font-size: 2rem;
        color: var(--text-primary);
        margin-bottom: 15px;
      }

      .modal-content-custom p {
        color: var(--text-secondary);
        font-size: 1.1rem;
        line-height: 1.7;
      }

      .btn-close-modal {
        background: linear-gradient(135deg, var(--gradient-start), var(--gradient-end));
        border: none;
        color: white;
        padding: 12px 40px;
        border-radius: 50px;
        font-weight: 600;
        margin-top: 20px;
        cursor: pointer;
        transition: all 0.3s ease;
      }

      .btn-close-modal:hover {
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.2);
      }

      /* Footer */
      footer {
        background: linear-gradient(135deg, #1f2937 0%, #111827 100%);
        color: white;
        padding: 40px 0 20px;
      }

      .footer-content {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: 30px;
        margin-bottom: 30px;
      }

      .footer-section {
        flex: 1;
        min-width: 250px;
      }

      .footer-section h5 {
        font-size: 1.2rem;
        margin-bottom: 1rem;
        color: var(--accent-gold);
      }

      .footer-links {
        list-style: none;
        padding: 0;
      }

      .footer-links li {
        margin-bottom: 0.5rem;
      }

      .footer-links a {
        color: #d1d5db;
        text-decoration: none;
        transition: color 0.3s ease;
      }

      .footer-links a:hover {
        color: var(--accent-gold);
      }

      .copyright {
        text-align: center;
        padding-top: 20px;
        border-top: 1px solid rgba(255, 255, 255, 0.1);
        color: #9ca3af;
      }

      /* Responsive Design */
      @media (max-width: 770px) {
        .hero-section {
          padding: 140px 15px 80px;
        }

        .application-section {
          padding: 60px 0;
        }

        .form-container {
          padding: 40px 25px;
        }

        .progress-container {
          padding: 25px 20px;
        }

        .step-label {
          font-size: 0.75rem;
        }

        .step-circle {
          width: 35px;
          height: 35px;
          font-size: 0.9rem;
        }

        .form-navigation {
          flex-direction: column;
        }

        .btn-prev,
        .btn-next,
        .btn-submit {
          width: 100%;
        }
      }

      @media (max-width: 576px) {
        .step-label {
          display: none;
        }

        .logo-header h2 {
          font-size: 1.6rem;
        }

        .step-title {
          font-size: 1.5rem;
        }

        .modal-content-custom {
          padding: 35px 25px;
        }

        .modal-content-custom h3 {
          font-size: 1.6rem;
        }
      }

  body
    //- ================= NAVBAR =================
    nav.navbar.navbar-expand-lg.navbar-dark.fixed-top
      .container
        a.navbar-brand.d-flex.align-items-center(href='/')
          img.rounded-circle(src='./img/nlogo.png' width='45' alt='Logo')
          span.ms-2 Pratistha Financial Services

        button.navbar-toggler(type='button' data-bs-toggle='collapse' data-bs-target='#navMenu')
          span.navbar-toggler-icon

        #navMenu.collapse.navbar-collapse
          ul.navbar-nav.ms-auto
            li.nav-item
              a.nav-link(href='/') Home
            li.nav-item
              a.nav-link(href='/services') Services
            li.nav-item
              a.nav-link(href='/about') About
            li.nav-item
              a.nav-link(href='/contact') Contact
    //- ================= HERO SECTION =================
    section.hero-section
      .container
        h1 Apply for Loan
        p Complete the application form below and we'll get back to you soon

    //- ================= APPLICATION SECTION =================
    section.application-section
      .container
        .application-container
          //- Progress Bar
          .progress-container
            .progress-steps
              .progress-line
                .progress-line-fill#progressFill(style='width: 33.33%')
              .step.active#step1Circle
                .step-circle 1
                .step-label Personal Info
              .step#step2Circle
                .step-circle 2
                .step-label Loan Details
              .step#step3Circle
                .step-circle 3
                .step-label Contact Info

          //- Form Container
          .form-container
            .logo-header
              img(src='img/nlogo.png' alt='Pratistha Financial Services Logo')
              h2 Loan Application
              p Fill out the form and we will contact you soon

            form#loanApplicationForm.needs-validation(action='/apply' method='post' novalidate)
              //- ========== STEP 1: Personal Information ==========
              .form-step.active#step1
                h3.step-title
                  i.fas.fa-user.me-2
                  | Personal Information

                .info-card
                  i.fas.fa-info-circle
                  p Please provide your accurate personal details. All fields marked with * are mandatory.

                .row.g-4
                  .col-12
                    label.form-label(for='name')
                      i.fas.fa-user
                      | Full Name *
                    input.form-control(
                      type='text'
                      id='name'
                      name='name'
                      placeholder='Enter your full name'
                      required
                      minlength='2'
                      maxlength='100'
                    )
                    .invalid-feedback Please enter your full name (2-100 characters).
                    .valid-feedback Looks good!

                  .col-md-6
                    label.form-label(for='age')
                      i.fas.fa-calendar
                      | Age *
                    input.form-control(
                      type='number'
                      id='age'
                      name='age'
                      placeholder='Enter your age'
                      required
                      min='18'
                      max='100'
                    )
                    .invalid-feedback Age must be between 18 and 100.
                    .valid-feedback Looks good!

                  .col-md-6
                    label.form-label(for='employment')
                      i.fas.fa-briefcase
                      | Employment Type *
                    select.form-select(id='employment' name='employement' required)
                      option(value='' selected disabled) Select employment type
                      option(value='Govt. employ') Government Employee
                      option(value='Pvt. employ') Private Employee
                      option(value='self employ') Self Employed
                      option(value='business') Business Owner
                    .invalid-feedback Please select your employment type.
                    .valid-feedback Looks good!

                  .col-12
                    label.form-label(for='position')
                      i.fas.fa-id-badge
                      | Position/Designation *
                    input.form-control(
                      type='text'
                      id='position'
                      name='position'
                      placeholder='e.g., Manager, Director, Proprietor'
                      required
                      minlength='2'
                      maxlength='100'
                    )
                    .invalid-feedback Please enter your position or designation.
                    .valid-feedback Looks good!

                  .col-md-6
                    label.form-label(for='state')
                      i.fas.fa-map-marker-alt
                      | State & Pincode *
                    input.form-control(
                      type='text'
                      id='state'
                      name='state'
                      placeholder='e.g., Delhi - 110001'
                      required
                    )
                    .invalid-feedback Please enter your state and pincode.
                    .valid-feedback Looks good!

                  .col-md-6
                    label.form-label(for='district')
                      i.fas.fa-city
                      | District *
                    input.form-control(
                      type='text'
                      id='district'
                      name='district'
                      placeholder='Enter your district'
                      required
                    )
                    .invalid-feedback Please enter your district.
                    .valid-feedback Looks good!

                .form-navigation
                  button.btn-next(type='button' onclick='nextStep()')
                    | Next Step
                    i.fas.fa-arrow-right.ms-2

              //- ========== STEP 2: Loan Details ==========
              .form-step#step2
                h3.step-title
                  i.fas.fa-money-bill-wave.me-2
                  | Loan Requirements

                .info-card
                  i.fas.fa-info-circle
                  p Specify your loan requirements. Our team will process your application and find the best options for you.

                .row.g-4
                  .col-12
                    label.form-label(for='loan')
                      i.fas.fa-hand-holding-usd
                      | Type of Loan *
                    select.form-select(id='loan' name='loan' required)
                      option(value='' selected disabled) Select loan type
                      option(value='personal loan') Personal Loan
                      option(value='loan against property (LAP)') Loan Against Property (LAP)
                      option(value='bussiness loan') Business Loan
                      option(value='auto loan') Auto Loan
                      option(value='home loan') Home Loan
                      option(value='mortgage loan') Mortgage Loan
                      option(value='machinery loan') Machinery Loan
                    .invalid-feedback Please select the type of loan you need.
                    .valid-feedback Looks good!

                  .col-md-6
                    label.form-label(for='income')
                      i.fas.fa-rupee-sign
                      | Monthly Income (₹) *
                    input.form-control(
                      type='number'
                      id='income'
                      name='income'
                      placeholder='Enter monthly income'
                      required
                      min='10000'
                      step='1000'
                    )
                    .invalid-feedback Please enter your monthly income (minimum ₹10,000).
                    .valid-feedback Looks good!

                  .col-md-6
                    label.form-label(for='loan_amount')
                      i.fas.fa-money-check-alt
                      | Loan Amount Required (₹) *
                    input.form-control(
                      type='number'
                      id='loan_amount'
                      name='loan_amount'
                      placeholder='Enter loan amount'
                      required
                      min='30000'
                      step='10000'
                    )
                    .invalid-feedback Please enter loan amount (minimum ₹30,000).
                    .valid-feedback Looks good!

                  .col-12
                    label.form-label(for='tenure')
                      i.fas.fa-calendar-alt
                      | Loan Tenure (years) *
                    input.form-control(
                      type='number'
                      id='tenure'
                      name='tenure'
                      placeholder='Enter loan duration in years'
                      required
                      min='1'
                      max='30'
                    )
                    .invalid-feedback Tenure must be between 1 and 30 years.
                    .valid-feedback Looks good!

                .form-navigation
                  button.btn-prev(type='button' onclick='prevStep()')
                    i.fas.fa-arrow-left.me-2
                    | Previous
                  button.btn-next(type='button' onclick='nextStep()')
                    | Next Step
                    i.fas.fa-arrow-right.ms-2

              //- ========== STEP 3: Contact Information ==========
              .form-step#step3
                h3.step-title
                  i.fas.fa-phone.me-2
                  | Contact Information

                .info-card
                  i.fas.fa-info-circle
                  p Provide your contact details so we can reach you. We'll contact you within 24-48 hours.

                .row.g-4
                  .col-12
                    label.form-label(for='phone')
                      i.fas.fa-mobile-alt
                      | Mobile Number *
                    input.form-control(
                      type='tel'
                      id='phone'
                      name='phone'
                      placeholder='Enter 10-digit mobile number'
                      required
                      pattern='[0-9]{10}'
                      maxlength='10'
                    )
                    .invalid-feedback Please enter a valid 10-digit mobile number.
                    .valid-feedback Looks good!

                  .col-12
                    label.form-label(for='email')
                      i.fas.fa-envelope
                      | Email Address *
                    input.form-control(
                      type='email'
                      id='email'
                      name='email'
                      placeholder='Enter your email address'
                      required
                    )
                    .invalid-feedback Please enter a valid email address.
                    .valid-feedback Looks good!

                  .col-12
                    .form-check
                      input.form-check-input(
                        type='checkbox'
                        id='terms'
                        required
                      )
                      label.form-check-label(for='terms')
                        | I agree to the 
                        a(href='#') terms and conditions
                        |  and authorize Pratistha Financial Services to contact me.
                      .invalid-feedback You must agree before submitting.

                .form-navigation
                  button.btn-prev(type='button' onclick='prevStep()')
                    i.fas.fa-arrow-left.me-2
                    | Previous
                  button.btn-submit(type='submit' id='submitBtn')
                    span#submitText
                      i.fas.fa-paper-plane.me-2
                      | Submit Application
                    span.d-none#submitSpinner
                      span.spinner-border.spinner-border-sm.me-2(role='status')
                      | Submitting...

    //- ================= SUCCESS MODAL =================
    .success-modal#successModal
      .modal-content-custom
        .modal-icon
          i.fas.fa-check
        h3 Application Submitted!
        p Thank you for applying! We have received your loan application. Our team will review your details and contact you within 24-48 hours on your registered mobile number or email.
        p.mt-3
          strong Application Status: 
          | Under Review
        button.btn-close-modal(onclick='closeModal()') Close

    //- ================= FOOTER =================
    footer
      .container
        .footer-content
          .footer-section
            h5 Pratistha Financial Services
            p(style='color: #d1d5db;') Your trusted partner for all financial solutions. We provide comprehensive loan services with complete transparency and support.

          .footer-section
            h5 Quick Links
            ul.footer-links
              li
                a(href='/') Home
              li
                a(href='/services') Services
              li
