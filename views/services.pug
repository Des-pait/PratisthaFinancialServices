    script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js')
    
    script.
      const form = document.getElementById('emiForm');
      
      form.addEventListener('submit', function(event) {
        event.preventDefault();
        
        const principal = parseFloat(document.getElementById('principal').value);
        const interestRate = parseFloat(document.getElementById('interest').value);
        const tenure = parseInt(document.getElementById('tenure').value);
        
        const monthlyInterestRate = (interestRate / 100) / 12;
        const totalNumberOfPayments = tenure * 12;
        
        const emi = (principal * monthlyInterestRate * Math.pow(1 + monthlyInterestRate, totalNumberOfPayments)) / (Math.pow(1 + monthlyInterestRate, totalNumberOfPayments) - 1);
        
        const resultElement = document.getElementById('result');
        const emiAmountElement = document.getElementById('emiAmount');
        emiAmountElement.textContent = emi.toFixed(2);
        resultElement.classList.add('show');
        
        const amortizationTable = document.getElementById('amortizationTable');
        const tbody = amortizationTable.querySelector('tbody');
        tbody.innerHTML = '';
        
        let remainingBalance = principal;
        for (let i = 1; i <= totalNumberOfPayments; i++) {
          const interest = remainingBalance * monthlyInterestRate;
          const principalPaid = emi - interest;
          const openingBalance = remainingBalance;
          remainingBalance -= principalPaid;
          
          const tr = document.createElement('tr');
          tr.innerHTML = `
            <td>${i}</td>
            <td>₹${openingBalance.toFixed(2)}</td>
            <td>₹${emi.toFixed(2)}</td>
            <td>₹${interest.toFixed(2)}</td>
            <td>₹${principalPaid.toFixed(2)}</td>
            <td>₹${Math.max(0, remainingBalance).toFixed(2)}</td>
          `;
          tbody.appendChild(tr);
        }
        
        setTimeout(() => {
          amortizationTable.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }, 300);
      });
      
      window.addEventListener('scroll', function() {
        const navbar = document.querySelector('.navbar');
        if (window.scrollY > 50) {
          navbar.style.boxShadow = '0 8px 30px rgba(0, 0, 0, 0.2)';
        } else {
          navbar.style.boxShadow = '0 4px 20px rgba(0, 0, 0, 0.1)';
        }
      });