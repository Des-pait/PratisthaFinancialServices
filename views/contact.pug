doctype html
html(lang="en")
  head
    meta(charset='UTF-8')
    meta(http-equiv='X-UA-Compatible' content='IE=edge')
    meta(name='viewport' content='width=device-width, initial-scale=1.0')
    meta(name='description' content='Contact Pratistha Business & Finance Solutions for all your financial needs')
    meta(name='robots' content='index, follow')
    
    //- Security Headers
    meta(http-equiv='Content-Security-Policy' content="default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://www.google.com https://maps.googleapis.com; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data: https:; frame-src https://www.google.com;")
    meta(http-equiv='X-Content-Type-Options' content='nosniff')
    meta(http-equiv='X-Frame-Options' content='SAMEORIGIN')
    meta(name='referrer' content='strict-origin-when-cross-origin')
    
    title Pratistha Business & Finance Solutions - Contact Us
    
    link(rel='stylesheet' href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css')
    link(rel='stylesheet' href='https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css')
    link(rel='preconnect' href='https://fonts.googleapis.com')
    link(rel='preconnect' href='https://fonts.gstatic.com' crossorigin)
    link(href='https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=Outfit:wght@300;400;600&display=swap' rel='stylesheet')
    link(href='./style.css' rel='stylesheet')
 
    style.
      :root {
        --primary-emerald: #059669;
        --primary-dark: #047857;
        --accent-gold: #f59e0b;
        --text-primary: #1f2937;
        --text-secondary: #6b7280;
        --bg-light: #f9fafb;
        --gradient-start: #10b981;
        --gradient-end: #059669;
        --danger: #ef4444;
        --warning: #f59e0b;
        --info: #3b82f6;
      }

      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family: 'Outfit', sans-serif;
        color: var(--text-primary);
        overflow-x: hidden;
        background: linear-gradient(180deg, #ffffff 0%, var(--bg-light) 100%);
      }

      h1, h2, h3, h4, h5 {
        font-family: 'Playfair Display', serif;
      }

      /* Hero Section */
      .hero-section {
        background: linear-gradient(135deg, rgba(5, 150, 105, 0.95) 0%, rgba(4, 120, 87, 0.9) 100%);
        padding: 160px 20px 100px;
        text-align: center;
        color: white;
        position: relative;
        overflow: hidden;
      }

      .hero-section::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: radial-gradient(circle at 30% 50%, rgba(245, 158, 11, 0.15) 0%, transparent 50%);
        animation: pulse 8s ease-in-out infinite;
      }

      @keyframes pulse {
        0%, 100% { opacity: 0.5; }
        50% { opacity: 1; }
      }

      .hero-section h1 {
        font-size: clamp(2.5rem, 5vw, 4rem);
        margin-bottom: 1rem;
        text-shadow: 2px 2px 4px rgba(0,0,0,0.2);
        position: relative;
        z-index: 1;
      }

      .hero-section p {
        font-size: clamp(1rem, 2vw, 1.3rem);
        max-width: 700px;
        margin: 0 auto;
        opacity: 0.95;
        position: relative;
        z-index: 1;
      }

      /* Contact Section */
      .contact-container {
        padding: 100px 0;
      }

      .contact-wrapper {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 60px;
        max-width: 1200px;
        margin: 0 auto;
      }

      /* Contact Info */
      .contact-info {
        background: white;
        padding: 50px 40px;
        border-radius: 25px;
        box-shadow: 0 15px 50px rgba(0, 0, 0, 0.1);
      }

      .contact-info h2 {
        font-size: 2.5rem;
        color: var(--text-primary);
        margin-bottom: 20px;
      }

      .contact-info p {
        color: var(--text-secondary);
        font-size: 1.1rem;
        line-height: 1.8;
        margin-bottom: 40px;
      }

      .info-item {
        display: flex;
        align-items: flex-start;
        margin-bottom: 30px;
        padding: 20px;
        background: linear-gradient(135deg, #ecfdf5, #d1fae5);
        border-radius: 15px;
        transition: all 0.3s ease;
      }

      .info-item:hover {
        transform: translateX(10px);
        box-shadow: 0 5px 20px rgba(5, 150, 105, 0.2);
      }

      .info-icon {
        width: 50px;
        height: 50px;
        background: linear-gradient(135deg, var(--gradient-start), var(--gradient-end));
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        margin-right: 20px;
        color: white;
        font-size: 1.3rem;
        box-shadow: 0 5px 15px rgba(5, 150, 105, 0.3);
      }

      .info-content h4 {
        font-size: 1.2rem;
        color: var(--text-primary);
        margin-bottom: 5px;
      }

      .info-content p {
        margin: 0;
        color: var(--text-secondary);
        font-size: 1rem;
        line-height: 1.6;
      }

      /* Contact Form */
      .contact-form {
        background: white;
        padding: 50px 40px;
        border-radius: 25px;
        box-shadow: 0 15px 50px rgba(0, 0, 0, 0.1);
      }

      .contact-form h2 {
        font-size: 2.2rem;
        color: var(--text-primary);
        margin-bottom: 30px;
      }

      .form-step {
        display: none;
      }

      .form-step.active {
        display: block;
        animation: fadeIn 0.3s ease-in;
      }

      @keyframes fadeIn {
        from {
          opacity: 0;
          transform: translateY(10px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      .step-indicator {
        display: flex;
        justify-content: space-between;
        margin-bottom: 30px;
        position: relative;
      }

      .step-indicator::before {
        content: '';
        position: absolute;
        top: 20px;
        left: 0;
        right: 0;
        height: 2px;
        background: #e5e7eb;
        z-index: 0;
      }

      .step {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: #e5e7eb;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 600;
        color: var(--text-secondary);
        position: relative;
        z-index: 1;
        transition: all 0.3s ease;
      }

      .step.active {
        background: linear-gradient(135deg, var(--gradient-start), var(--gradient-end));
        color: white;
        box-shadow: 0 5px 15px rgba(5, 150, 105, 0.3);
      }

      .step.completed {
        background: var(--primary-emerald);
        color: white;
      }

      .form-label {
        font-weight: 600;
        color: var(--text-primary);
        margin-bottom: 0.5rem;
        font-size: 1rem;
        display: flex;
        align-items: center;
      }

      .form-label i {
        margin-right: 8px;
        color: var(--primary-emerald);
      }

      .form-control {
        padding: 15px 20px;
        border-radius: 12px;
        border: 2px solid #e5e7eb;
        font-size: 1rem;
        transition: all 0.3s ease;
      }

      .form-control:focus {
        border-color: var(--primary-emerald);
        box-shadow: 0 0 0 0.2rem rgba(5, 150, 105, 0.15);
        outline: none;
      }

      .form-control.is-valid {
        border-color: var(--primary-emerald);
      }

      .form-control.is-invalid {
        border-color: #ef4444;
      }

      .invalid-feedback,
      .valid-feedback {
        font-size: 0.875rem;
        margin-top: 0.5rem;
      }

      .char-count {
        font-size: 0.85rem;
        color: var(--text-secondary);
        text-align: right;
        margin-top: 0.25rem;
      }

      .char-count.warning {
        color: #f59e0b;
      }

      .char-count.danger {
        color: #ef4444;
      }

      /* OTP Section */
      .otp-section {
        background: linear-gradient(135deg, #ecfdf5, #d1fae5);
        padding: 25px;
        border-radius: 15px;
        margin-bottom: 20px;
        border: 2px solid var(--primary-emerald);
      }

      .otp-header {
        display: flex;
        align-items: center;
        margin-bottom: 15px;
      }

      .otp-icon {
        width: 45px;
        height: 45px;
        background: linear-gradient(135deg, var(--gradient-start), var(--gradient-end));
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 1.2rem;
        margin-right: 15px;
      }

      .otp-header h4 {
        margin: 0;
        color: var(--text-primary);
        font-size: 1.2rem;
      }

      .otp-input-group {
        display: flex;
        gap: 10px;
        margin-top: 15px;
      }

      .otp-input {
        flex: 1;
      }

      .btn-send-otp {
        background: linear-gradient(135deg, var(--gradient-start), var(--gradient-end));
        border: none;
        color: white;
        padding: 15px 30px;
        border-radius: 12px;
        font-weight: 600;
        transition: all 0.3s ease;
        white-space: nowrap;
        cursor: pointer;
      }

      .btn-send-otp:hover:not(:disabled) {
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.2);
      }

      .btn-send-otp:disabled {
        opacity: 0.6;
        cursor: not-allowed;
      }

      .otp-timer {
        font-size: 0.9rem;
        color: var(--text-secondary);
        margin-top: 10px;
        display: flex;
        align-items: center;
        gap: 5px;
      }

      .otp-timer.warning {
        color: var(--warning);
      }

      .resend-link {
        color: var(--primary-emerald);
        text-decoration: none;
        font-weight: 600;
        cursor: pointer;
        transition: color 0.3s ease;
      }

      .resend-link:hover {
        color: var(--primary-dark);
        text-decoration: underline;
      }

      .resend-link.disabled {
        color: var(--text-secondary);
        cursor: not-allowed;
        pointer-events: none;
      }

      /* Alert Messages */
      .alert-custom {
        padding: 15px 20px;
        border-radius: 12px;
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        gap: 12px;
        animation: slideDown 0.3s ease-out;
      }

      @keyframes slideDown {
        from {
          opacity: 0;
          transform: translateY(-10px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      .alert-success {
        background: #d1fae5;
        color: #047857;
        border: 1px solid #10b981;
      }

      .alert-error {
        background: #fee2e2;
        color: #991b1b;
        border: 1px solid #ef4444;
      }

      .alert-info {
        background: #dbeafe;
        color: #1e40af;
        border: 1px solid #3b82f6;
      }

      .alert-warning {
        background: #fef3c7;
        color: #92400e;
        border: 1px solid #f59e0b;
      }

      /* Buttons */
      .btn-group-custom {
        display: flex;
        gap: 15px;
        margin-top: 25px;
      }

      .btn-primary-custom {
        background: linear-gradient(135deg, var(--gradient-start), var(--gradient-end));
        border: none;
        color: white;
        padding: 16px 40px;
        border-radius: 50px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 1px;
        transition: all 0.3s ease;
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
        cursor: pointer;
        flex: 1;
      }

      .btn-primary-custom:hover:not(:disabled) {
        transform: translateY(-3px);
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.2);
        color: white;
      }

      .btn-primary-custom:disabled {
        opacity: 0.6;
        cursor: not-allowed;
        transform: none;
      }

      .btn-secondary-custom {
        background: transparent;
        border: 2px solid var(--primary-emerald);
        color: var(--primary-emerald);
        padding: 14px 40px;
        border-radius: 50px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 1px;
        transition: all 0.3s ease;
        cursor: pointer;
      }

      .btn-secondary-custom:hover {
        background: var(--primary-emerald);
        color: white;
      }

      .spinner-border-sm {
        width: 1rem;
        height: 1rem;
        border-width: 0.15em;
      }

      /* Map Section */
      .map-section {
        padding: 80px 0;
        background: white;
      }

      .section-title {
        font-size: clamp(2.5rem, 4vw, 3.5rem);
        margin-bottom: 2rem;
        text-align: center;
        position: relative;
        display: inline-block;
        width: 100%;
      }

      .section-title::after {
        content: '';
        position: absolute;
        bottom: -15px;
        left: 50%;
        transform: translateX(-50%);
        width: 120px;
        height: 4px;
        background: linear-gradient(90deg, var(--accent-gold), var(--primary-emerald));
        border-radius: 2px;
      }

      .map-container {
        max-width: 1200px;
        margin: 40px auto 0;
        border-radius: 25px;
        overflow: hidden;
        box-shadow: 0 15px 50px rgba(0, 0, 0, 0.1);
      }

      .map-container iframe {
        width: 100%;
        height: 450px;
        border: none;
      }

      /* Footer */
      footer {
        background: linear-gradient(135deg, #1f2937 0%, #111827 100%);
        color: white;
        padding: 40px 0 20px;
      }

      .footer-content {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: 30px;
        margin-bottom: 30px;
      }

      .footer-section {
        flex: 1;
        min-width: 250px;
      }

      .footer-section h5 {
        font-size: 1.2rem;
        margin-bottom: 1rem;
        color: var(--accent-gold);
      }

      .footer-links {
        list-style: none;
        padding: 0;
      }

      .footer-links li {
        margin-bottom: 0.5rem;
      }

      .footer-links a {
        color: #d1d5db;
        text-decoration: none;
        transition: color 0.3s ease;
      }

      .footer-links a:hover {
        color: var(--accent-gold);
      }

      .copyright {
        text-align: center;
        padding-top: 20px;
        border-top: 1px solid rgba(255, 255, 255, 0.1);
        color: #9ca3af;
      }

      /* Success Modal */
      .success-modal {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0, 0, 0, 0.5);
        z-index: 9999;
        align-items: center;
        justify-content: center;
      }

      .success-modal.show {
        display: flex;
      }

      .modal-content-custom {
        background: white;
        padding: 50px;
        border-radius: 25px;
        text-align: center;
        max-width: 500px;
        margin: 20px;
        animation: modalSlideIn 0.4s ease-out;
      }

      @keyframes modalSlideIn {
        from {
          opacity: 0;
          transform: translateY(-50px) scale(0.9);
        }
        to {
          opacity: 1;
          transform: translateY(0) scale(1);
        }
      }

      .modal-icon {
        width: 80px;
        height: 80px;
        background: linear-gradient(135deg, var(--gradient-start), var(--gradient-end));
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 25px;
        font-size: 2.5rem;
        color: white;
        box-shadow: 0 10px 30px rgba(5, 150, 105, 0.3);
      }

      .modal-content-custom h3 {
        font-size: 2rem;
        color: var(--text-primary);
        margin-bottom: 15px;
      }

      .modal-content-custom p {
        color: var(--text-secondary);
        font-size: 1.1rem;
        line-height: 1.7;
      }

      .btn-close-modal {
        background: linear-gradient(135deg, var(--gradient-start), var(--gradient-end));
        border: none;
        color: white;
        padding: 12px 40px;
        border-radius: 50px;
        font-weight: 600;
        margin-top: 20px;
        cursor: pointer;
        transition: all 0.3s ease;
      }

      .btn-close-modal:hover {
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.2);
      }

      /* Security Badge */
      .security-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: linear-gradient(135deg, #ecfdf5, #d1fae5);
        padding: 8px 16px;
        border-radius: 20px;
        font-size: 0.85rem;
        color: var(--primary-dark);
        margin-top: 15px;
      }

      .security-badge i {
        color: var(--primary-emerald);
      }

      /* Responsive Design */
      @media (max-width: 992px) {
        .contact-wrapper {
          grid-template-columns: 1fr;
          gap: 40px;
        }

        .contact-info,
        .contact-form {
          padding: 40px 30px;
        }
      }

      @media (max-width: 770px) {
        .hero-section {
          padding: 140px 15px 80px;
        }

        .contact-container,
        .map-section {
          padding: 60px 0;
        }

        .contact-info,
        .contact-form {
          padding: 35px 25px;
        }

        .contact-info h2,
        .contact-form h2 {
          font-size: 2rem;
        }

        .info-item {
          padding: 15px;
        }

        .map-container iframe {
          height: 350px;
        }

        .btn-group-custom {
          flex-direction: column;
        }

        .otp-input-group {
          flex-direction: column;
        }
      }

      @media (max-width: 576px) {
        .contact-info h2,
        .contact-form h2 {
          font-size: 1.8rem;
        }

        .info-icon {
          width: 45px;
          height: 45px;
          font-size: 1.1rem;
          margin-right: 15px;
        }

        .modal-content-custom {
          padding: 35px 25px;
        }

        .modal-content-custom h3 {
          font-size: 1.6rem;
        }
      }

  body
    //- ================= NAVBAR =================
    nav.navbar.navbar-expand-lg.navbar-dark.fixed-top
      .container
        a.navbar-brand.d-flex.align-items-center(href='/')
          img.rounded-circle(src='./img/nlogo.png' width='45' alt='Logo')
          span.ms-2 Pratistha Business & Finance Solutions

        button.navbar-toggler(type='button' data-bs-toggle='collapse' data-bs-target='#navMenu')
          span.navbar-toggler-icon
        button.navbar-arrow-toggler(type="button" data-bs-toggle="collapse" data-bs-target="#navMenu" aria-label="Toggle navigation")
          i.fa-solid.fa-chevron-down

        #navMenu.collapse.navbar-collapse
          ul.navbar-nav.ms-auto
            li.nav-item
              a.nav-link(href='/') Home
            li.nav-item
              a.nav-link(href='/services') Services
            li.nav-item
              a.nav-link(href='/about') About
            li.nav-item
              a.nav-link.active(href='/contact') Contact

    //- ================= HERO SECTION =================
    section.hero-section
      .container
        h1 Contact Us
        p We're here to help you with all your financial needs. Get in touch with us today!

    //- ================= CONTACT SECTION =================
    section.contact-container
      .container
        .contact-wrapper
          //- Contact Information
          .contact-info
            h2 Get In Touch
            p We'd love to hear from you. Our team is ready to assist you with any questions or concerns you may have.

            .info-item
              .info-icon
                i.fas.fa-map-marker-alt
              .info-content
                h4 Our Location
                p Delhi, India
                p All States Across India

            .info-item
              .info-icon
                i.fas.fa-clock
              .info-content
                h4 Working Hours
                p Monday - Saturday
                p 9:00 AM - 6:00 PM

            .info-item
              .info-icon
                i.fas.fa-shield-alt
              .info-content
                h4 Secure & Verified
                p Email OTP Verification
                p 100% Data Protection

          //- Contact Form with OTP Verification
          .contact-form
            h2 Send Us a Message
            
            //- Step Indicator
            .step-indicator
              .step.active#step1Indicator 1
              .step#step2Indicator 2
              .step#step3Indicator 3

            //- Alert Container
            #alertContainer

            form#contactForm.needs-validation(novalidate)
              //- STEP 1: Contact Details
              .form-step.active#step1
                .mb-4
                  label.form-label(for='name')
                    i.fas.fa-user
                    | Full Name *
                  input.form-control(
                    type='text'
                    id='name'
                    name='name'
                    placeholder='Enter your full name'
                    required
                    minlength='2'
                    maxlength='50'
                    autocomplete='name'
                  )
                  .invalid-feedback Please enter your name (2-50 characters).
                  .valid-feedback Looks good!

                .mb-4
                  label.form-label(for='email')
                    i.fas.fa-envelope
                    | Email Address *
                  input.form-control(
                    type='email'
                    id='email'
                    name='email'
                    placeholder='Enter your email address'
                    required
                    autocomplete='email'
                  )
                  .invalid-feedback Please enter a valid email address.
                  .valid-feedback Looks good!

                .mb-4
                  label.form-label(for='phone')
                    i.fas.fa-phone
                    | Mobile Number *
                  input.form-control(
                    type='tel'
                    id='phone'
                    name='phone'
                    placeholder='Enter 10-digit mobile number'
                    required
                    pattern='[0-9]{10}'
                    maxlength='10'
                    autocomplete='tel'
                  )
                  .invalid-feedback Please enter a valid 10-digit mobile number.
                  .valid-feedback Looks good!

                .btn-group-custom
                  button.btn-primary-custom(type='button' onclick='goToStep(2)')
                    | Next Step
                    i.fas.fa-arrow-right.ms-2

              //- STEP 2: Location & Requirement
              .form-step#step2
                .mb-4
                  label.form-label(for='state')
                    i.fas.fa-map-marker-alt
                    | State & Pincode *
                  input.form-control(
                    type='text'
                    id='state'
                    name='state'
                    placeholder='e.g., Delhi - 110001'
                    required
                  )
                  .invalid-feedback Please enter your state and pincode.
                  .valid-feedback Looks good!

                .mb-4
                  label.form-label(for='district')
                    i.fas.fa-city
                    | District *
                  input.form-control(
                    type='text'
                    id='district'
                    name='district'
                    placeholder='Enter your district'
                    required
                  )
                  .invalid-feedback Please enter your district.
                  .valid-feedback Looks good!

                .mb-4
                  label.form-label(for='require')
                    i.fas.fa-comment-alt
                    | Describe Your Requirement *
                  textarea.form-control(
                    id='require'
                    name='require'
                    rows='5'
                    placeholder='Please describe your financial requirement in detail'
                    required
                    minlength='10'
                    maxlength='200'
                  )
                  .char-count#charCount 0 / 200 characters
                  .invalid-feedback Message must be between 10 and 200 characters.
                  .valid-feedback Looks good!

                .btn-group-custom
                  button.btn-secondary-custom(type='button' onclick='goToStep(1)')
                    i.fas.fa-arrow-left.me-2
                    | Back
                  button.btn-primary-custom(type='button' onclick='goToStep(3)')
                    | Next Step
                    i.fas.fa-arrow-right.ms-2

              //- STEP 3: Email Verification
              .form-step#step3
                .otp-section
                  .otp-header
                    .otp-icon
                      i.fas.fa-shield-alt
                    div
                      h4 Email Verification
                      p.mb-0(style='color: var(--text-secondary); font-size: 0.9rem;') We'll send a 6-digit OTP to your email

                  .otp-input-group
                    input.form-control.otp-input(
                      type='text'
                      id='emailDisplay'
                      readonly
                      style='background: #f9fafb;'
                    )
                    button.btn-send-otp(type='button' id='sendOtpBtn' onclick='sendOTP()')
                      span#sendOtpText
                        i.fas.fa-paper-plane.me-2
                        | Send OTP
                      span.d-none#sendOtpSpinner
                        span.spinner-border.spinner-border-sm.me-2(role='status')
                        | Sending...

                  #otpTimerContainer.d-none
                    .otp-timer#otpTimer
                      i.fas.fa-clock.me-1
                      span OTP expires in: 
                      strong#timerDisplay 10:00
                    p.mb-0.mt-2(style='font-size: 0.85rem; color: var(--text-secondary);')
                      | Didn't receive OTP? 
                      a.resend-link.disabled#resendLink(onclick='resendOTP()') Resend

                .mb-4#otpInputContainer.d-none
                  label.form-label(for='otp')
                    i.fas.fa-key
                    | Enter OTP *
                  input.form-control(
                    type='text'
                    id='otp'
                    name='otp'
                    placeholder='Enter 6-digit OTP'
                    required
                    pattern='[0-9]{6}'
                    maxlength='6'
                    inputmode='numeric'
                  )
                  .invalid-feedback Please enter the 6-digit OTP sent to your email.
                  .valid-feedback OTP verified!

                .security-badge
                  i.fas.fa-lock
                  span Your data is encrypted and secure

                .btn-group-custom
                  button.btn-secondary-custom(type='button' onclick='goToStep(2)')
                    i.fas.fa-arrow-left.me-2
                    | Back
                  button.btn-primary-custom(type='submit' id='submitBtn' disabled)
                    span#submitText
                      i.fas.fa-check-circle.me-2
                      | Submit Request
                    span.d-none#submitSpinner
                      span.spinner-border.spinner-border-sm.me-2(role='status')
                      | Submitting...

    //- ================= MAP SECTION =================
    section.map-section
      .container
        h2.section-title Our Location
        .map-container
          iframe(
            src='https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d224346.48129098735!2d77.04417205!3d28.527252849999998!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x390cfd5b347eb62d%3A0x52c2b7494e204dce!2sDelhi!5e0!3m2!1sen!2sin!4v1234567890123!5m2!1sen!2sin'
